diff --git a/cw.c b/cw.c
new file mode 100644
index 0000000..b5d4eb6
--- /dev/null
+++ b/cw.c
@@ -0,0 +1,33 @@
+/* cw.h: Cyberworld Endless's additions to gpSP (GPL-2.0 as gpSP) */
+#include "common.h"
+#include "cw.h"
+
+bool cw_mode;
+uint8_t *cw_rom_pages[CW_PAGES];
+bool (*cw_hooked)(uint32_t pc);
+
+void cw_rom_page_set(uint32_t index, uint8_t *page)
+{
+  if (index >= CW_PAGES)
+    return;
+  cw_rom_pages[index] = page;
+  /* (the mirrors at 0x0A and 0x0C as map_rom_entry sets them; a 16 MB ROM
+   * fills its 0x08 and 0x0A spans once and 0x0C's half) */
+  memory_map_read[(0x8000000 / (32 * 1024)) + index] = page;
+  memory_map_read[(0xA000000 / (32 * 1024)) + index] = page;
+  if (index < 512)
+    memory_map_read[(0xC000000 / (32 * 1024)) + index] = page;
+}
+
+void cw_flush(void)
+{
+  flush_dynarec_caches();
+}
+
+/* (gpSP alone, as the libretro core it builds: no hooks; the game's own
+ * cw_hook_call takes this one's place where it links gpSP in) */
+__attribute__((weak)) uint32_t cw_hook_call(uint32_t pc)
+{
+  (void)pc;
+  return 0;
+}
diff --git a/cw.h b/cw.h
new file mode 100644
index 0000000..67904f4
--- /dev/null
+++ b/cw.h
@@ -0,0 +1,31 @@
+/* Cyberworld Endless's additions to gpSP (the game's docker/gpsp-cyberworld.patch,
+ * GPL-2.0 as gpSP), included by gpSP and by the game alike: the ROM taken
+ * from the game's own pages, and hooks the translator calls out to at
+ * hooked instructions. */
+#ifndef CW_H
+#define CW_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* The ROM in 32 KB pages the game holds (set before retro_init and
+ * retro_load_game: no ROM buffer of gpSP's own is allocated, nor a file
+ * read) */
+#define CW_PAGES 512
+extern bool cw_mode;
+extern uint8_t *cw_rom_pages[CW_PAGES];
+/* A page pointed elsewhere (the game copied it to write it), its mirrors
+ * too; the translations of ROM code are dropped at the next cw_flush */
+void cw_rom_page_set(uint32_t index, uint8_t *page);
+/* Every translation dropped, ROM's and RAM's: after the ROM's code or the
+ * hooks changed, between frames */
+void cw_flush(void);
+
+/* Hooks: whether the instruction at pc is hooked (asked as a block is
+ * translated), and the call the translated code makes before it runs:
+ * 0 to run the instruction, else the address to go on at, bit 0 set for
+ * Thumb code (the game's, cw_hook_call) */
+extern bool (*cw_hooked)(uint32_t pc);
+uint32_t cw_hook_call(uint32_t pc);
+
+#endif
