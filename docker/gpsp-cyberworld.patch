index 61e02da..043bf29 100644
--- a/mips/mips_emit.h
+++ b/mips/mips_emit.h
@@ -61,6 +61,7 @@ u32 execute_read_cpsr();
 u32 execute_read_spsr();
 void execute_swi(u32 pc);
 void mips_cheat_hook(void);
+void mips_cw_hook(void);
 
 u32 execute_spsr_restore(u32 address);
 void execute_store_cpsr(u32 new_cpsr, u32 store_mask);
@@ -1849,6 +1850,26 @@ u32 execute_store_cpsr_body(u32 _cpsr, u32 address)
 #define thumb_process_cheats()                                                \
   generate_function_call(mips_cheat_hook);
 
+/* (Cyberworld Endless's hooks, cw.h: mips_cw_hook saves the ARM registers,
+ * makes the game's call with the hooked pc in a0 and loads them back, its
+ * answer in v0: an address to go on at, as a bx goes, else on to the
+ * instruction. The cycles counted so far stay counted on the way on.) */
+#define cw_hook_callout()                                                     \
+{                                                                             \
+  u8 *jmpinst;                                                                \
+  u32 cycles_held = cycle_count;                                              \
+  generate_load_pc(reg_a0, pc);                                               \
+  generate_function_call(mips_cw_hook);                                       \
+  mips_emit_b_filler(beq, reg_rv, reg_zero, jmpinst);                         \
+  mips_emit_addu(reg_a0, reg_rv, reg_zero);                                   \
+  generate_indirect_branch_cycle_update(dual);                                \
+  generate_branch_patch_conditional(jmpinst, translation_ptr);                \
+  cycle_count = cycles_held;                                                  \
+}
+
+#define thumb_cw_hook() cw_hook_callout()
+#define arm_cw_hook() cw_hook_callout()
+
 #define arm_process_cheats()                                                  \
   generate_function_call(mips_cheat_hook);
 
diff --git a/mips/mips_stub.S b/mips/mips_stub.S
index ef3eecf..3f549a4 100644
--- a/mips/mips_stub.S
+++ b/mips/mips_stub.S
@@ -273,6 +273,19 @@ defsymbl(mips_cheat_hook)
   nop
 
 
+# Cyberworld Endless's hooks (cw.h): $4 the hooked pc, the game's answer
+# in $2 (an address to go on at, else 0), the ARM registers saved for it
+# and loaded back after, as the game may change them
+defsymbl(mips_cw_hook)
+  sw $ra, REG_SAVE2($16)
+  save_registers
+  cfncall cw_hook_call, 11
+  lw $ra, REG_SAVE2($16)
+  restore_registers
+  jr $ra
+  nop
+
+
 # Loads the main context and returns to it.
 # ARM regs must be saved before branching here
 return_to_main:
@@ -640,6 +653,7 @@ fnptrs:
   .long process_cheats                 # 8
   .long check_and_raise_interrupts     # 9
   .long execute_arm_vram               # 10
+  .long cw_hook_call                   # 11
 
 #if !defined(MMAP_JIT_CACHE)
 
