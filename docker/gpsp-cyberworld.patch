+      map_rom_entry(read, i, cw_rom_pages[i], CW_PAGES);
+    return 0;
+  }
   gamepak_file_large = filestream_open(name, RETRO_VFS_FILE_ACCESS_READ,
                                        RETRO_VFS_FILE_ACCESS_HINT_NONE);
   if(gamepak_file_large)
