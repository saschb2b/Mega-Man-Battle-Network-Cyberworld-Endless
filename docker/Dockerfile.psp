# Build image for the PSP (psp/README.md): pspdev's toolchain with its
# packages (SDL2), pinned, and the GBA cores built for it: gpSP with the
# game's additions, its core (docker/gpsp.sh), and mGBA's library, whose
# parts the rest of the code names. The game builds into an EBOOT.PBP for
# the memory stick's PSP/GAME folder (build.py psp).
FROM pspdev/pspdev@sha256:ee385df3aa783189d5a033af5eb1d4a9cdd93718fb8bf652ec7bb48e54038a8b
RUN apk add --no-cache curl patch python3
COPY mgba.sh /tmp/mgba.sh
RUN sh /tmp/mgba.sh psp
COPY gpsp.sh gpsp-cyberworld.patch /tmp/
RUN sh /tmp/gpsp.sh psp /opt/gpsp/psp /tmp/gpsp-cyberworld.patch
