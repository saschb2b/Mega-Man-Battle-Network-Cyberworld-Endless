# Build image for the Nintendo 3DS (issue #9): devkitPro's devkitARM with
# libctru and citro3d, SDL2 and the embedded GBA core built for it, and the
# tools that pack a CIA. The game builds into a .3dsx for the Homebrew
# Launcher and a .cia the HOME Menu installs (build.py 3ds).
FROM devkitpro/devkitarm:latest
COPY sdl2.sh /tmp/sdl2.sh
RUN sh /tmp/sdl2.sh 3ds
COPY mgba.sh /tmp/mgba.sh
RUN sh /tmp/mgba.sh 3ds
COPY ctrtools.sh /tmp/ctrtools.sh
RUN sh /tmp/ctrtools.sh
