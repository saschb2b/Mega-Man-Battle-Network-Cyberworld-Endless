# Build image for the Android app (android/, build.py android): the SDK, the
# NDK and Gradle, SDL2's source (its Java half goes into the app, its C half
# is built with it) and the GBA core for each Android ABI.
FROM debian:trixie
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    openjdk-21-jdk-headless curl unzip ca-certificates cmake make \
 && rm -rf /var/lib/apt/lists/*
ENV ANDROID_HOME=/opt/android-sdk
# the command-line tools (SHA-1 d313adb7... as Google's repository lists it)
RUN mkdir -p $ANDROID_HOME/cmdline-tools && cd /tmp \
 && curl -fsSL -o tools.zip https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip \
 && echo "2d2d50857e4eb553af5a6dc3ad507a17adf43d115264b1afc116f95c92e5e258  tools.zip" | sha256sum -c - \
 && unzip -q tools.zip -d $ANDROID_HOME/cmdline-tools && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
 && rm tools.zip
RUN yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses > /dev/null \
 && $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --install "platforms;android-35" "build-tools;35.0.0" "ndk;27.2.12479018" "cmake;3.22.1" > /dev/null
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/27.2.12479018
RUN curl -fsSL -o /tmp/gradle.zip https://services.gradle.org/distributions/gradle-8.10.2-bin.zip \
 && echo "31c55713e40233a8303827ceb42ca48a47267a0ad4bab9177123121e71524c26  /tmp/gradle.zip" | sha256sum -c - \
 && unzip -q /tmp/gradle.zip -d /opt && ln -s /opt/gradle-8.10.2/bin/gradle /usr/local/bin/gradle && rm /tmp/gradle.zip
COPY sdl2.sh /tmp/sdl2.sh
RUN sh /tmp/sdl2.sh android
# The embedded GBA core (docs/EMULATION.md), one static library per ABI
COPY mgba.sh /tmp/mgba.sh
RUN sh /tmp/mgba.sh android
