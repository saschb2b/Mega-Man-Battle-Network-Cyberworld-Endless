<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, as Android has it by default, but for this device
     itself: a developer's local stand-ins (an update.json, the statistics'
     Umami) reached through `adb reverse`, never a host on the network. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
