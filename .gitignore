# Build output and local caches
/build/
/.build/
__pycache__/
*.pyc
tools/romlab/romlab.bin

# Never commit game data or saves
*.gba
*.sav
*.srm
*.ss
*.state
*.dat
rom/
savedata/

# A host's private settings and optional evidence logs are not distribution files.
/server/server.ini
/server/*.jsonl
/server-data/

# the Android app's build (build.py android)
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
